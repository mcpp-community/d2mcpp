{
  "name": "d2mcpp (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/cpp:ubuntu-24.04",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "twxs.cmake",
        "ms-vscode.cmake-tools",
        "formulahendry.code-runner"
      ]
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/home/vscode/.xlings/subos/current/bin:${containerEnv:PATH}"
  },
  "waitFor": "postCreateCommand",
  "postCreateCommand": "/bin/bash .devcontainer/postCreate.sh",
  "postAttachCommand": "/bin/bash .devcontainer/readiness.sh"
}
